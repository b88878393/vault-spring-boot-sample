# Example only. Copy is NOT needed: scripts/vault-init.sh creates .env (gitignored) with real values for your local
# dev Vault. All values below are placeholders.

# AppRole credentials of the application (written by scripts/vault-init.sh)
VAULT_ROLE_ID=00000000-0000-0000-0000-000000000000
VAULT_SECRET_ID=00000000-0000-0000-0000-000000000000

# Optional overrides for docker-compose.yml (DEMO defaults are used when unset)
# VAULT_DEV_ROOT_TOKEN=dev-only-root-token
# POSTGRES_PASSWORD=postgres-demo-password
